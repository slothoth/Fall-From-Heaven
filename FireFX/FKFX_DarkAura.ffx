<Instances>
	<0000F533ED8601BC Type="AssetObjects::FireFXScriptData">
		<m_script text='// FKFX_DarkAura: generated by civ6/fx_tools/dark_aura.py (Meshabber dark aura)
// A sparse cloud of volcano smoke (FireFX_Pyroclastic_Smoke) filling one ellipsoid around the unit,
// played from the Root bone. Few, big, short-lived puffs so the body shows through as the cloud churns.
// Each puff gets a random red tint (the original aura faded red out over a life; here it varies per puff).
#include "Transform.FXH"
#include "Flipbook.FXH"
#include "Tweening.FXH"

// ---- tuning (lengths in MODEL units; DA_SCALE converts to FX units: FX = 0.1 x model, measured) ----
#define DA_SCALE 0.1
#define DA_CENTER float3(6.0, 0.0, 67.0)    // ellipsoid centre (Root frame: x forward, y left, z up)
#define DA_RADIUS_X 50.0                     // front-back
#define DA_RADIUS_Y 42.0                     // side to side
#define DA_RADIUS_Z 100.0                    // up-down
#define DA_RATE 9.0                          // puffs per second: the SPARSITY knob (fewer = more gaps)
#define DA_SIZE 80.0                         // final puff size
#define DA_START 0.4                         // size at birth (x final size)
#define DA_LIFE_MIN 2.2
#define DA_LIFE_MAX 3.8
#define DA_DRIFT 8.0                         // random drift over a life (churn)
#define DA_RISE 6.0                          // world-up drift over a life (bounded)
#define DA_SPIN 0.15                         // puff spin (radians per second)
#define DA_SCROLL 0.25                       // cloud flipbook animation speed
#define DA_ALPHA 1.0
#define DA_COLOR float3(0.035, 0.032, 0.032) // the volcano smoke&apos;s dark grey
#define DA_RED_MAX 0.1                       // per-puff random red tint, 0 .. this (the original aura&apos;s peak red)
#define DA_RED_BIAS 2                        // 1 = evenly spread, 2+ = mostly dark puffs with a few red ones

emitter DA_Puff
{
	varying float3 p_base;		// Root-local (model units)
	varying float3 p_drift;
	varying number p_size;
	varying number p_age;
	varying number p_inv_life;
	varying number p_time;
	varying number p_rotation;
	varying number p_spin;
	varying number p_red;
	SPAWN(number in_dummy = 0)
	{
		local float3 r = normalize(float3(random() - 0.5, random() - 0.5, random() - 0.5));
		local number d = max(random(), max(random(), random()));	// max of 3 uniforms = cube root: uniform volume fill
		p_base = DA_CENTER + float3(r.x * DA_RADIUS_X, r.y * DA_RADIUS_Y, r.z * DA_RADIUS_Z) * d;
		p_drift = normalize(float3(random() - 0.5, random() - 0.5, random() - 0.5)) * DA_DRIFT;
		p_size = DA_SIZE * mix(0.7, 1.3, random());
		p_inv_life = 1.0 / mix(DA_LIFE_MIN, DA_LIFE_MAX, random());
		p_age = 0;
		p_time = random() * 100;
		p_rotation = random() * 6.2831853;
		p_spin = mix(-DA_SPIN, DA_SPIN, random());
		local number rr = random();
		p_red = DA_RED_MAX * ((DA_RED_BIAS &gt; 1.5) ? rr * rr : rr);	// fixed for the puff&apos;s life (random, not a fade)
	}
	SIM
	{
		local number time_multiplier = (is_orphan() &gt; 0) ? 10 : 1;	// fade out fast once the unit is gone
		p_age = p_age + delta_time() * p_inv_life * time_multiplier;
		p_time = p_time + delta_time() * (1 - p_age);
		p_rotation = p_rotation + p_spin * delta_time();
		kill(p_age &gt; 1);
	}
	property geometry_type = quad_rotated;
	property material_type = quad_unlit;
	property blend_type = alpha;
	property shadows = false;	// FireFX default is true
	property material_lighting = directional;
	property normalmap = true;
	property masked = true;
	property priority = 15;
	RENDER
	{
		local float3 up = ApplyInverse(root_rotation(), float3(0, 0, 1));	// world up in the Root frame
		local number a = SMOOTHSTOPARCH4(p_age) * DA_ALPHA;
		local number s = p_size * mix(DA_START, 1, SMOOTHSTOP2(p_age));
		export("BASECOLOR_UV", NumberToFlipbookUV(float2(16, 16), p_time * DA_SCROLL * 0.5));
		export("BASECOLOR_UV_ROTATE", p_time * 0.25);
		export("MASK_UV", NumberToFlipbookUV(float2(8, 8), -p_time * 0.35));
		export("MASK_UV_ROTATE", 0);
		export("POSITION", (p_base + p_drift * p_age + up * (DA_RISE * p_age)) * DA_SCALE);
		export("SCALE", point2d(s, s) * DA_SCALE);
		export("ROTATION", p_rotation);
		export("TANGENT", normalize(p_drift + float3(0, 0, 0.5)));
		export("COLOR", (DA_COLOR + float3(p_red, p_red * 0.1, 0)) * (a * (1 - p_age)));	// premultiplied, as the volcano smoke
		export("ALPHA", a);
	}
}

group DA_Aura
{
	SIM
	{
		emit_rate("DA_Puff", DA_RATE) { export("in_dummy", 0); };
	}
}
'/>
	</0000F533ED8601BC>
</Instances>
