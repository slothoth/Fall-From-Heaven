<Instances>
	<00009B210CA2BB28 Type="AssetObjects::FireFXScriptData">
		<m_script text='// FKFX_BalrogFire: generated by civ6/fx_tools/balrog_fire.py (Balrog rift + flares)
// 70 table entries (rift pieces + flare hotspots, bone-local); groups pick from their slice.
#include "Math.FXH"
#include "Transform.FXH"
#include "Flipbook.FXH"
#include "Tweening.FXH"


// ---- tuning (lengths in MODEL units; BF_SCALE converts to FX units: FX = 0.1 x model, measured) ----
#define BF_SCALE 0.1
// rift (always on)
#define RIFT_RATE 14.0          // flames per second per 100 model units of rift line
#define RIFT_SIZE 34.0          // flame size at birth
#define RIFT_GROW 0.9           // extra size over a life (x RIFT_SIZE)
#define RIFT_LIFE 0.8
#define RIFT_SPEED 22.0         // outward from the skin (model units / s)
#define RIFT_RISE 30.0          // upward drift
#define RIFT_SPREAD 0.35        // direction randomness (0 = straight out of the skin)
#define RIFT_JITTER 4.0         // spawn scatter around the line
#define RIFT_COLOR float3(1.0, 0.55, 0.25) * 0.55
#define RIFT_GLOW_RATE 3.0
// surge (roars): multipliers on the rift
#define SURGE_RATE 3.0
#define SURGE_SIZE 1.5
#define SURGE_SPEED 1.8
#define SURGE_BRIGHT 1.6
// flares (hits / roar beats): one burst per hotspot
#define FLARE_COUNT 7.0
#define FLARE_SIZE 40.0
#define FLARE_GROW 1.2
#define FLARE_LIFE 0.65
#define FLARE_SPEED 70.0
#define FLARE_RISE 25.0
#define FLARE_SPREAD 0.3
#define FLARE_JITTER 6.0
#define FLARE_COLOR float3(1.0, 0.6, 0.3) * 0.7
// shared
#define BF_BUOYANCY 40.0        // upward acceleration (model units / s^2)
#define BF_DRAG 1.5
#define BF_FLIPBOOK_SPEED 0.6   // flipbook pages per second (0..1 = whole 16x8 sheet)
#define BF_FOLLOW 0.85          // RIFT/SURGE only: how much flames ride the moving body (1 = glued, 0 = left behind)


emitter BF_Flame
{
	varying float3 p_position;	// WORLD space
	varying float3 p_velocity;
	varying number p_age;
	varying number p_inv_life;
	varying number p_size;
	varying number p_grow;
	varying number p_page;
	varying number p_rotation;
	varying number p_spin;
	varying number p_time;
	varying float3 p_color;
	varying number p_follow;	// 0 = pure world space (flares); rift/surge pass BF_FOLLOW
	varying float4 p_root_rot;	// attachment transform last frame (to carry the flame along with the bone)
	varying float3 p_root_pos;
	varying number p_root_scale;
	SPAWN(number in_first = 0, number in_count = 1, number in_follow = 0,
	      number in_speed = 1, number in_rise = 0, number in_spread = 0.3, number in_jitter = 0, number in_size = 1,
	      number in_grow = 1, number in_life = 1, float3 in_color = float3(1, 1, 1))
	{
