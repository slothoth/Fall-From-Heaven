		emit_rate("BF_Flame", (is_orphan() &gt; 0) ? 0 : RIFT_RATE * SURGE_RATE * 2.025)
		{
			export("in_first", 0); export("in_count", 28); export("in_follow", BF_FOLLOW);
			export("in_speed", RIFT_SPEED * SURGE_SPEED); export("in_rise", RIFT_RISE); export("in_spread", RIFT_SPREAD);
			export("in_jitter", RIFT_JITTER); export("in_size", RIFT_SIZE * SURGE_SIZE); export("in_grow", RIFT_GROW);
			export("in_life", RIFT_LIFE); export("in_color", RIFT_COLOR * SURGE_BRIGHT);
		};
		emit_rate("BF_Glow", (is_orphan() &gt; 0) ? 0 : RIFT_GLOW_RATE * SURGE_RATE * 2.025)
		{
			export("in_first", 0); export("in_count", 28);
			export("in_size", RIFT_SIZE * 3.0); export("in_life", 0.6); export("in_color", RIFT_COLOR * 0.35 * SURGE_BRIGHT);
		};
	}
}

