group BFR_spine_upper
{
	varying number p_time;
	SPAWN
	{
		p_time = 0;
	}
	SIM
	{
		p_time = p_time + delta_time();
		emit_rate("BF_Flame", RIFT_RATE * 2.025)
		{
			export("in_first", 0); export("in_count", 28); export("in_follow", BF_FOLLOW);
			export("in_speed", RIFT_SPEED); export("in_rise", RIFT_RISE); export("in_spread", RIFT_SPREAD);
			export("in_jitter", RIFT_JITTER); export("in_size", RIFT_SIZE); export("in_grow", RIFT_GROW);
			export("in_life", RIFT_LIFE); export("in_color", RIFT_COLOR);
		};
		emit_rate("BF_Glow", RIFT_GLOW_RATE * 2.025)
		{
			export("in_first", 0); export("in_count", 28);
			export("in_size", RIFT_SIZE * 2.2); export("in_life", 0.7); export("in_color", RIFT_COLOR * 0.25);
		};
	}
}

