<Instances>
	<0000B9A61D70CCB1 Type="AssetObjects::FireFXScriptData">
		<m_script text='// FKFX_DarkWreath: generated by civ6/fx_tools/dark_wreath.py (Meshabber wreath of darkness)
// One puff emitter played at several bones; WD_Large / WD_Small only set radius, size and rate.
// Look = the base volcano smoke (FireFX_Pyroclastic_Smoke: animated 16x16 cloud flipbook + 8x8 scrolling mask,
// normal-mapped, lit), as in FfH&apos;s FireFX_Smoke_Aura - but short-lived and bone-attached instead of a 10-25 s plume.
#include "Transform.FXH"
#include "Flipbook.FXH"
#include "Tweening.FXH"

// ---- tuning (lengths in MODEL units; WD_SCALE converts to FX units: FX = 0.1 x model, measured) ----
#define WD_SCALE 0.1
#define WD_DENSITY 1.0          // puff count multiplier (performance knob)
#define WD_LIFE_MIN 2.0         // puff life = how soon a cloud is culled (the old aura lived 10-25 s)
#define WD_LIFE_MAX 3.5
#define WD_START 0.35           // size at birth (x final size); grows to full size (as the volcano smoke)
#define WD_SWIRL 0.35           // swirl circle radius (x cloud radius)
#define WD_SWIRL_TURNS 0.3      // swirl turns over a life
#define WD_RISE 6.0             // world-up drift over a whole life (bounded: never climbs far)
#define WD_SPIN 0.15            // puff spin (radians per second)
#define WD_SCROLL 0.25          // cloud flipbook animation speed (as the volcano smoke&apos;s scroll speed)
#define WD_ALPHA 1.0
#define WD_COLOR float3(0.035, 0.032, 0.032)   // the volcano smoke&apos;s dark grey
// torso clouds
#define WD_LARGE_RADIUS 16.0
#define WD_LARGE_SIZE 24.0
#define WD_LARGE_RATE 6.0
// limb clouds
#define WD_SMALL_RADIUS 8.0
#define WD_SMALL_SIZE 14.0
#define WD_SMALL_RATE 3.0

emitter WD_Puff
{
	varying float3 p_base;		// bone-local (model units)
	varying number p_radius;
	varying number p_size;
	varying number p_age;
	varying number p_inv_life;
	varying number p_phase;
	varying number p_time;
	varying number p_rotation;
	varying number p_spin;
	SPAWN(number in_radius = 10, number in_size = 10)
	{
		local float3 r = float3(random() - 0.5, random() - 0.5, random() - 0.5) * 2;
		p_base = normalize(r) * (in_radius * sqrt(random()));	// filled sphere, denser towards the middle
		p_radius = in_radius;
		p_size = in_size * mix(0.7, 1.3, random());
		p_inv_life = 1.0 / mix(WD_LIFE_MIN, WD_LIFE_MAX, random());
		p_age = 0;
		p_phase = random() * 6.2831853;
		p_time = random() * 100;
		p_rotation = random() * 6.2831853;
		p_spin = mix(-WD_SPIN, WD_SPIN, random());
	}
	SIM
	{
		local number time_multiplier = (is_orphan() &gt; 0) ? 10 : 1;	// fade out fast once the unit is gone
		p_age = p_age + delta_time() * p_inv_life * time_multiplier;
		p_time = p_time + delta_time() * (1 - p_age);
		p_rotation = p_rotation + p_spin * delta_time();
		kill(p_age &gt; 1);
	}
	property geometry_type = quad_rotated;
	property material_type = quad_unlit;
	property blend_type = alpha;
	property shadows = false;	// FireFX default is true
	property material_lighting = directional;
	property normalmap = true;
	property masked = true;
	property priority = 15;
	RENDER
	{
		local number sw = p_phase + p_age * WD_SWIRL_TURNS * 6.2831853;
		local float3 swirl = float3(cos(sw), sin(sw), sin(sw * 0.7 + p_phase) * 0.5) * (WD_SWIRL * p_radius);
		local float3 up = ApplyInverse(root_rotation(), float3(0, 0, 1));	// world up in the bone&apos;s frame
		local number a = SMOOTHSTOPARCH4(p_age) * WD_ALPHA;
		local number s = p_size * mix(WD_START, 1, SMOOTHSTOP2(p_age));
		export("BASECOLOR_UV", NumberToFlipbookUV(float2(16, 16), p_time * WD_SCROLL * 0.5));
		export("BASECOLOR_UV_ROTATE", p_time * 0.25);
		export("MASK_UV", NumberToFlipbookUV(float2(8, 8), -p_time * 0.35));
		export("MASK_UV_ROTATE", 0);
		export("POSITION", (p_base + swirl + up * (WD_RISE * p_age)) * WD_SCALE);	// bone-local: rides the animation
		export("SCALE", point2d(s, s) * WD_SCALE);
		export("ROTATION", p_rotation);
		export("TANGENT", float3(-sin(sw), cos(sw), 0.3));
		export("COLOR", WD_COLOR * (a * (1 - p_age)));	// premultiplied, as the volcano smoke
		export("ALPHA", a);
	}
}

group WD_Large
{
	SIM
	{
		emit_rate("WD_Puff", WD_LARGE_RATE * WD_DENSITY) { export("in_radius", WD_LARGE_RADIUS); export("in_size", WD_LARGE_SIZE); };
	}
}

group WD_Small
{
	SIM
	{
		emit_rate("WD_Puff", WD_SMALL_RATE * WD_DENSITY) { export("in_radius", WD_SMALL_RADIUS); export("in_size", WD_SMALL_SIZE); };
	}
}
'/>
	</0000B9A61D70CCB1>
</Instances>
