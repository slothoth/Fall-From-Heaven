	SPAWN(number in_time = 0)
	{
		local number k = floor(random() * 24.0);	// one of this bone&apos;s 24 interior points
		p_base = ((k &lt; 12) ? ((k &lt; 6) ? ((k &lt; 3) ? ((k &lt; 1) ? float3(-2.0470, 8.7268, -0.4357) : ((k &lt; 2) ? float3(3.7294, 5.7149, 1.4354) : float3(-1.5136, 8.7086, 8.7837))) : ((k &lt; 4) ? float3(-0.9870, 1.5952, 7.5838) : ((k &lt; 5) ? float3(-0.3930, 9.9029, -5.2844) : float3(1.1134, 9.0291, 3.5411)))) : ((k &lt; 9) ? ((k &lt; 7) ? float3(2.4332, -3.2282, -2.4228) : ((k &lt; 8) ? float3(0.8268, -5.3386, -3.3261) : float3(-1.2919, 11.3105, -0.1553))) : ((k &lt; 10) ? float3(-1.6078, 9.1475, -3.9627) : ((k &lt; 11) ? float3(3.5425, 4.1003, -8.9641) : float3(3.2213, 5.1200, -5.2033))))) : ((k &lt; 18) ? ((k &lt; 15) ? ((k &lt; 13) ? float3(-0.6704, 10.1564, -7.4259) : ((k &lt; 14) ? float3(2.6142, -1.5076, 9.4071) : float3(5.0673, -3.9334, -5.7384))) : ((k &lt; 16) ? float3(-1.7131, 4.8909, -0.5825) : ((k &lt; 17) ? float3(5.5593, -0.8323, 1.9016) : float3(0.4660, 9.4241, -1.9239)))) : ((k &lt; 21) ? ((k &lt; 19) ? float3(3.5470, 0.9432, 5.4172) : ((k &lt; 20) ? float3(2.8697, 0.1187, -4.1507) : float3(-1.4868, 7.9816, -6.8916))) : ((k &lt; 22) ? float3(0.2816, -4.4168, 0.0861) : ((k &lt; 23) ? float3(0.2576, 0.2706, 4.0548) : float3(-0.5304, -1.0883, -9.1347)))))) + float3(random() - 0.5, random() - 0.5, random() - 0.5) * (2 * SD_JITTER);
		p_inv_life = 1.0 / mix(SD_LIFE_MIN, SD_LIFE_MAX, random());
		p_age = 0;
		p_phase = random() * 6.2831853;
		p_size = mix(0.7, 1.3, random());
		p_page = floor(random() * 3.999);
	}
	SIM
	{
		p_age = p_age + delta_time() * p_inv_life;
		kill(p_age &gt; 1);
	}
	property geometry_type = quad_rotated;
	property material_type = quad_unlit;
	property blend_type = alpha;
	property shadows = false;	// FireFX default is true: puffs/ribbons cast shadows
	property material_lighting = non_directional;
	RENDER
	{
		local number sw = p_phase + p_age * SD_SWIRL_TURNS * 6.2831853;
		local float3 swirl = float3(cos(sw), sin(sw), sin(sw * 0.7 + p_phase) * 0.5) * SD_SWIRL_RADIUS;
		local number a = 4 * p_age * (1 - p_age);
		local number t = p_phase + p_age / p_inv_life;
		export("POSITION", (p_base + swirl) * SD_SCALE);	// bone-local: rides the animation
		export("SCALE", point2d(1, 1) * (SD_SIZE * p_size * (1 + SD_GROW * p_age) * SD_SCALE));
		export("ROTATION", t * SD_SPIN);
		local number pc = p_page - 2 * floor(p_page * 0.5);	// 2x2 flipbook page -&gt; column, row
		local number pr = floor(p_page * 0.5);
		export("BASECOLOR_UV", float4(pc * 0.5, pr * 0.5, pc * 0.5 + 0.5, pr * 0.5 + 0.5));
		export("COLOR", SD_COLOR * (a * SD_ALPHA));	// premultiplied
		export("ALPHA", a * SD_ALPHA);
	}
}

group SLG_Spine1
{
	varying number p_time;
	SPAWN
	{
		p_time = 0;
	}
	SIM
	{
		p_time = p_time + delta_time();
		emit_rate("SL_Spine1", 24.0 * SD_RATE * SD_DENSITY) { export("in_time", p_time); };
	}
}

