<Instances>
	<00001038A14D9498 Type="AssetObjects::FireFXScriptData">
		<m_script text='// FKFX_SpectreBodySmog: generated by civ6/fx_tools/mesh2firefx.py from BaseMale_Body_TorsoTop_01.cn6
// One emitter + group per bone; each group is the Root Emitter of that bone&apos;s .ptl, played from an
// attachment point on the bone, so particles (exported bone-local) ride the unit&apos;s animation.

// ---- tuning: lengths in model units, converted by SD_SCALE (FX units = 0.1 x model units, measured) ----
#define SD_SCALE 0.1            // model units -&gt; FX units (positions + sizes)
#define SD_DENSITY 1.0          // puff count multiplier (performance knob)
#define SD_RATE 0.35            // puffs per second per volume point (before DENSITY)
#define SD_LIFE_MIN 1.8
#define SD_LIFE_MAX 3.2
#define SD_SIZE 10.05            // puff size at birth
#define SD_GROW 1.2             // extra size gained over a life (x SD_SIZE)
#define SD_JITTER 3.87          // random spawn offset around the volume point
#define SD_SWIRL_RADIUS 3.09   // swirl circle radius
#define SD_SWIRL_TURNS 0.3      // swirl turns over a life
#define SD_SPIN 0.3             // puff texture spin (radians per second)
#define SD_ALPHA 0.5
#define SD_COLOR float3(0.05, 0.05, 0.07)

emitter SL_Pelvis
{
	varying float3 p_base;
	varying number p_age;
	varying number p_inv_life;
	varying number p_phase;
	varying number p_size;
	varying number p_page;
	SPAWN(number in_time = 0)
	{
		local number k = floor(random() * 17.0);	// one of this bone&apos;s 17 interior points
		p_base = ((k &lt; 8) ? ((k &lt; 4) ? ((k &lt; 2) ? ((k &lt; 1) ? float3(8.0192, 2.9861, -8.4472) : float3(4.3485, -5.0472, 5.3800)) : ((k &lt; 3) ? float3(6.6467, 1.4231, -7.9604) : float3(4.7620, 8.1521, -4.5732))) : ((k &lt; 6) ? ((k &lt; 5) ? float3(5.1225, 1.5557, -9.0740) : float3(7.2055, 6.4061, 1.9889)) : ((k &lt; 7) ? float3(8.1384, 4.9810, 5.0890) : float3(7.0915, 3.9222, 10.5739)))) : ((k &lt; 12) ? ((k &lt; 10) ? ((k &lt; 9) ? float3(3.7791, 6.2470, 5.5886) : float3(8.7512, -4.3625, -4.3158)) : ((k &lt; 11) ? float3(6.0043, -6.0209, -0.4850) : float3(8.2168, 1.1689, 1.6284))) : ((k &lt; 14) ? ((k &lt; 13) ? float3(5.6642, 6.6283, 8.1332) : float3(7.9615, -3.3151, -5.1842)) : ((k &lt; 15) ? float3(5.1834, 3.6833, -1.5458) : ((k &lt; 16) ? float3(3.3343, 9.9818, 3.1349) : float3(3.3005, 3.7236, -2.9298)))))) + float3(random() - 0.5, random() - 0.5, random() - 0.5) * (2 * SD_JITTER);
		p_inv_life = 1.0 / mix(SD_LIFE_MIN, SD_LIFE_MAX, random());
		p_age = 0;
		p_phase = random() * 6.2831853;
		p_size = mix(0.7, 1.3, random());
		p_page = floor(random() * 3.999);
	}
	SIM
	{
		p_age = p_age + delta_time() * p_inv_life;
		kill(p_age &gt; 1);
	}
	property geometry_type = quad_rotated;
	property material_type = quad_unlit;
	property blend_type = alpha;
	property shadows = false;	// FireFX default is true: puffs/ribbons cast shadows
	property material_lighting = non_directional;
	RENDER
	{
		local number sw = p_phase + p_age * SD_SWIRL_TURNS * 6.2831853;
		local float3 swirl = float3(cos(sw), sin(sw), sin(sw * 0.7 + p_phase) * 0.5) * SD_SWIRL_RADIUS;
		local number a = 4 * p_age * (1 - p_age);
		local number t = p_phase + p_age / p_inv_life;
		export("POSITION", (p_base + swirl) * SD_SCALE);	// bone-local: rides the animation
		export("SCALE", point2d(1, 1) * (SD_SIZE * p_size * (1 + SD_GROW * p_age) * SD_SCALE));
		export("ROTATION", t * SD_SPIN);
		local number pc = p_page - 2 * floor(p_page * 0.5);	// 2x2 flipbook page -&gt; column, row
		local number pr = floor(p_page * 0.5);
		export("BASECOLOR_UV", float4(pc * 0.5, pr * 0.5, pc * 0.5 + 0.5, pr * 0.5 + 0.5));
		export("COLOR", SD_COLOR * (a * SD_ALPHA));	// premultiplied
		export("ALPHA", a * SD_ALPHA);
	}
}

group SLG_Pelvis
{
	varying number p_time;
	SPAWN
	{
		p_time = 0;
	}
	SIM
	{
		p_time = p_time + delta_time();
		emit_rate("SL_Pelvis", 17.0 * SD_RATE * SD_DENSITY) { export("in_time", p_time); };
	}
}

emitter SL_Spine1
