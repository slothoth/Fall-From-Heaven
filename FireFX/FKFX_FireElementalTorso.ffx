<Instances>
	<0000026DF8D22790 Type="AssetObjects::FireFXScriptData">
		<m_script text='// FKFX_FireElementalTorso: generated by civ6/fx_tools/mesh2firefx.py from BaseMale_Body_TorsoTop_01.cn6
// One emitter + group per bone; each group is the Root Emitter of that bone&apos;s .ptl, played from an
// attachment point on the bone, so particles (exported bone-local) ride the unit&apos;s animation.

#include "Transform.FXH"
#include "Flipbook.FXH"

// ---- tuning: lengths in model units, converted by SD_SCALE (FX units = 0.1 x model units, measured) ----
#define SD_SCALE 0.1            // model units -&gt; FX units (positions + sizes)
#define SD_DENSITY 1.0          // puff count multiplier (performance knob)
#define SD_RATE 1.2            // puffs per second per volume point (before DENSITY)
#define SD_LIFE_MIN 0.45
#define SD_LIFE_MAX 0.85
#define SD_SIZE 30.99            // puff size at birth
#define SD_GROW 0.5             // extra size gained over a life (x SD_SIZE)
#define SD_JITTER 4.23          // random spawn offset around the volume point
#define SD_SWIRL_RADIUS 3.38   // swirl circle radius
#define SD_SWIRL_TURNS 0.2      // swirl turns over a life
#define SD_SPIN 0.4             // puff texture spin (radians per second)
#define SD_ALPHA 0.35
#define SD_COLOR float3(1.0, 0.32, 0.08)
#define SD_COLOR_HOT float3(1.0, 0.85, 0.45)   // flame colour at birth (fades to SD_COLOR)
#define SD_RISE 6.76            // world-up lick over a life (model units)
#define SD_FLIPBOOK_SPEED 0.6   // flipbook progress per second (0..1 = whole 16x8 sheet)

emitter SL_Pelvis
{
	varying float3 p_base;
	varying number p_age;
	varying number p_inv_life;
	varying number p_phase;
	varying number p_size;
	varying number p_page;
	SPAWN(number in_time = 0)
	{
		local number k = floor(random() * 13.0);	// one of this bone&apos;s 13 interior points
		p_base = ((k &lt; 6) ? ((k &lt; 3) ? ((k &lt; 1) ? float3(8.0192, 2.9861, -8.4472) : ((k &lt; 2) ? float3(4.3485, -5.0472, 5.3800) : float3(6.6467, 1.4231, -7.9604))) : ((k &lt; 4) ? float3(4.7620, 8.1521, -4.5732) : ((k &lt; 5) ? float3(5.1225, 1.5557, -9.0740) : float3(7.2055, 6.4061, 1.9889)))) : ((k &lt; 9) ? ((k &lt; 7) ? float3(8.1384, 4.9810, 5.0890) : ((k &lt; 8) ? float3(7.0915, 3.9222, 10.5739) : float3(3.7791, 6.2470, 5.5886))) : ((k &lt; 11) ? ((k &lt; 10) ? float3(8.7512, -4.3625, -4.3158) : float3(6.0043, -6.0209, -0.4850)) : ((k &lt; 12) ? float3(8.2168, 1.1689, 1.6284) : float3(5.6642, 6.6283, 8.1332))))) + float3(random() - 0.5, random() - 0.5, random() - 0.5) * (2 * SD_JITTER);
		p_inv_life = 1.0 / mix(SD_LIFE_MIN, SD_LIFE_MAX, random());
		p_age = 0;
		p_phase = random() * 6.2831853;
		p_size = mix(0.7, 1.3, random());
		p_page = floor(random() * 3.999);
	}
	SIM
	{
		p_age = p_age + delta_time() * p_inv_life;
		kill(p_age &gt; 1);
	}
	property geometry_type = quad_rotated;
	property material_type = quad_unlit_distorted;
	property blend_type = additive;
	property material_lighting = none;
	RENDER
	{
		local number sw = p_phase + p_age * SD_SWIRL_TURNS * 6.2831853;
		local float3 swirl = float3(cos(sw), sin(sw), sin(sw * 0.7 + p_phase) * 0.5) * SD_SWIRL_RADIUS;
		local number a = 4 * p_age * (1 - p_age);
		local number t = p_phase + p_age / p_inv_life;
		export("POSITION", (p_base + swirl + ApplyInverse(root_rotation(), float3(0, 0, 1)) * (SD_RISE * p_age)) * SD_SCALE);	// bone-local: rides the animation
		export("SCALE", point2d(1, 1) * (SD_SIZE * p_size * (1 + SD_GROW * p_age) * SD_SCALE));
		export("ROTATION", t * SD_SPIN);
		export("BASECOLOR_UV", NumberToFlipbookUV(float2(16, 8), frac(p_phase * 0.159 + t * SD_FLIPBOOK_SPEED)));
		export("DISTORTION_UV", float4(0, 0, 1, 1) * 0.5 + float4(t * 0.2, t, t * 0.2, t) * 0.25);
		export("DISTORTION_SCALE", 0.02);
		export("COLOR", mix(SD_COLOR_HOT, SD_COLOR, p_age) * (min(1, p_age * 8) * (1 - p_age) * (1 - p_age) * SD_ALPHA));	// additive
		export("ALPHA", 0);
	}
}

group SLG_Pelvis
{
	varying number p_time;
	SPAWN
	{
		p_time = 0;
	}
	SIM
	{
		p_time = p_time + delta_time();
		emit_rate("SL_Pelvis", 13.0 * SD_RATE * SD_DENSITY) { export("in_time", p_time); };
	}
}

emitter SL_Spine1
{
	varying float3 p_base;
	varying number p_age;
	varying number p_inv_life;
	varying number p_phase;
	varying number p_size;
	varying number p_page;
	SPAWN(number in_time = 0)
	{
		local number k = floor(random() * 20.0);	// one of this bone&apos;s 20 interior points
		p_base = ((k &lt; 10) ? ((k &lt; 5) ? ((k &lt; 2) ? ((k &lt; 1) ? float3(-2.0470, 8.7268, -0.4357) : float3(3.7294, 5.7149, 1.4354)) : ((k &lt; 3) ? float3(-1.5136, 8.7086, 8.7837) : ((k &lt; 4) ? float3(-0.9870, 1.5952, 7.5838) : float3(-0.3930, 9.9029, -5.2844)))) : ((k &lt; 7) ? ((k &lt; 6) ? float3(1.1134, 9.0291, 3.5411) : float3(2.4332, -3.2282, -2.4228)) : ((k &lt; 8) ? float3(0.8268, -5.3386, -3.3261) : ((k &lt; 9) ? float3(-1.2919, 11.3105, -0.1553) : float3(-1.6078, 9.1475, -3.9627))))) : ((k &lt; 15) ? ((k &lt; 12) ? ((k &lt; 11) ? float3(3.5425, 4.1003, -8.9641) : float3(3.2213, 5.1200, -5.2033)) : ((k &lt; 13) ? float3(-0.6704, 10.1564, -7.4259) : ((k &lt; 14) ? float3(2.6142, -1.5076, 9.4071) : float3(5.0673, -3.9334, -5.7384)))) : ((k &lt; 17) ? ((k &lt; 16) ? float3(-1.7131, 4.8909, -0.5825) : float3(5.5593, -0.8323, 1.9016)) : ((k &lt; 18) ? float3(0.4660, 9.4241, -1.9239) : ((k &lt; 19) ? float3(3.5470, 0.9432, 5.4172) : float3(2.8697, 0.1187, -4.1507)))))) + float3(random() - 0.5, random() - 0.5, random() - 0.5) * (2 * SD_JITTER);
		p_inv_life = 1.0 / mix(SD_LIFE_MIN, SD_LIFE_MAX, random());
		p_age = 0;
		p_phase = random() * 6.2831853;
		p_size = mix(0.7, 1.3, random());
		p_page = floor(random() * 3.999);
	}
	SIM
	{
		p_age = p_age + delta_time() * p_inv_life;
		kill(p_age &gt; 1);
	}
	property geometry_type = quad_rotated;
	property material_type = quad_unlit_distorted;
	property blend_type = additive;
	property material_lighting = none;
	RENDER
	{
		local number sw = p_phase + p_age * SD_SWIRL_TURNS * 6.2831853;
		local float3 swirl = float3(cos(sw), sin(sw), sin(sw * 0.7 + p_phase) * 0.5) * SD_SWIRL_RADIUS;
		local number a = 4 * p_age * (1 - p_age);
		local number t = p_phase + p_age / p_inv_life;
		export("POSITION", (p_base + swirl + ApplyInverse(root_rotation(), float3(0, 0, 1)) * (SD_RISE * p_age)) * SD_SCALE);	// bone-local: rides the animation
		export("SCALE", point2d(1, 1) * (SD_SIZE * p_size * (1 + SD_GROW * p_age) * SD_SCALE));
		export("ROTATION", t * SD_SPIN);
		export("BASECOLOR_UV", NumberToFlipbookUV(float2(16, 8), frac(p_phase * 0.159 + t * SD_FLIPBOOK_SPEED)));
		export("DISTORTION_UV", float4(0, 0, 1, 1) * 0.5 + float4(t * 0.2, t, t * 0.2, t) * 0.25);
		export("DISTORTION_SCALE", 0.02);
		export("COLOR", mix(SD_COLOR_HOT, SD_COLOR, p_age) * (min(1, p_age * 8) * (1 - p_age) * (1 - p_age) * SD_ALPHA));	// additive
		export("ALPHA", 0);
	}
}

group SLG_Spine1
{
	varying number p_time;
	SPAWN
	{
		p_time = 0;
	}
	SIM
	{
		p_time = p_time + delta_time();
		emit_rate("SL_Spine1", 20.0 * SD_RATE * SD_DENSITY) { export("in_time", p_time); };
	}
}

