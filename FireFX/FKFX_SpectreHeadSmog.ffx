		p_base = ((k &lt; 14) ? ((k &lt; 7) ? ((k &lt; 3) ? ((k &lt; 1) ? float3(3.0273, -2.8901, 3.0615) : ((k &lt; 2) ? float3(3.6510, 2.9491, 1.7420) : float3(3.2295, 2.4820, -6.4045))) : ((k &lt; 5) ? ((k &lt; 4) ? float3(7.1840, 0.4103, -2.3320) : float3(2.9604, 0.4544, -2.4728)) : ((k &lt; 6) ? float3(4.7913, 2.5794, 5.3584) : float3(2.6136, 3.2152, 2.4609)))) : ((k &lt; 10) ? ((k &lt; 8) ? float3(5.0929, 5.5869, -4.1761) : ((k &lt; 9) ? float3(4.4563, 2.8177, -3.9176) : float3(4.4532, 5.0418, 5.0465))) : ((k &lt; 12) ? ((k &lt; 11) ? float3(4.0831, 0.0535, -1.9883) : float3(4.5456, -3.0332, 5.5279)) : ((k &lt; 13) ? float3(5.8416, -1.6071, 3.1815) : float3(3.7069, 1.0615, -6.8620))))) : ((k &lt; 21) ? ((k &lt; 17) ? ((k &lt; 15) ? float3(5.9951, -2.2542, 4.7063) : ((k &lt; 16) ? float3(3.9809, 3.4813, 2.2532) : float3(2.6939, 5.4172, 2.8784))) : ((k &lt; 19) ? ((k &lt; 18) ? float3(2.1816, 4.6299, -4.6381) : float3(2.2618, 4.5892, 0.6341)) : ((k &lt; 20) ? float3(6.3036, 1.4276, 2.5744) : float3(3.7210, 3.8104, -4.5435)))) : ((k &lt; 24) ? ((k &lt; 22) ? float3(3.1531, -2.9158, 1.7303) : ((k &lt; 23) ? float3(6.2960, -0.6376, 3.7110) : float3(2.0063, 5.6059, -2.5552))) : ((k &lt; 26) ? ((k &lt; 25) ? float3(3.8447, 5.1854, -1.8343) : float3(5.0633, -0.6567, -1.2050)) : ((k &lt; 27) ? float3(3.1302, -3.1968, -2.4840) : float3(3.0379, 5.6030, -0.7827)))))) + float3(random() - 0.5, random() - 0.5, random() - 0.5) * (2 * SD_JITTER);
		p_inv_life = 1.0 / mix(SD_LIFE_MIN, SD_LIFE_MAX, random());
		p_age = 0;
