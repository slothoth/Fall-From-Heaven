	property blend_type = alpha;
	property shadows = false;	// FireFX default is true: puffs/ribbons cast shadows
	property material_lighting = non_directional;
	RENDER
	{
		local number sw = p_phase + p_age * SD_SWIRL_TURNS * 6.2831853;
		local float3 swirl = float3(cos(sw), sin(sw), sin(sw * 0.7 + p_phase) * 0.5) * SD_SWIRL_RADIUS;
		local number a = 4 * p_age * (1 - p_age);
		local number t = p_phase + p_age / p_inv_life;
		export("POSITION", (p_base + swirl) * SD_SCALE);	// bone-local: rides the animation
		export("SCALE", point2d(1, 1) * (SD_SIZE * p_size * (1 + SD_GROW * p_age) * SD_SCALE));
		export("ROTATION", t * SD_SPIN);
		local number pc = p_page - 2 * floor(p_page * 0.5);	// 2x2 flipbook page -&gt; column, row
		local number pr = floor(p_page * 0.5);
		export("BASECOLOR_UV", float4(pc * 0.5, pr * 0.5, pc * 0.5 + 0.5, pr * 0.5 + 0.5));
		export("COLOR", SD_COLOR * (a * SD_ALPHA));	// premultiplied
		export("ALPHA", a * SD_ALPHA);
	}
}

group SLG_Neck
{
	varying number p_time;
	SPAWN
	{
		p_time = 0;
	}
	SIM
	{
		p_time = p_time + delta_time();
		emit_rate("SL_Neck", 28.0 * SD_RATE * SD_DENSITY) { export("in_time", p_time); };
	}
}

