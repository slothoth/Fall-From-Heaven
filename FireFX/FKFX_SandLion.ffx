<Instances>
	<00009B5069E9E9C8 Type="AssetObjects::FireFXScriptData">
		<m_script text='// FKFX_SandLion: generated by civ6/fx_tools/mesh2firefx.py from Lion.cn6
// One emitter + group per bone; each group is the Root Emitter of that bone&apos;s .ptl, played from an
// attachment point on the bone, so particles (exported bone-local) ride the unit&apos;s animation.

// ---- tuning (model units; the lion is modelled small and scaled x10 by its artdef) ----
#define SR_SCALE 0.1            // model units -&gt; FX units (offsets + width); measured 0.1 with make_test_sphere.py&apos;s ruler
#define SR_RADIUS 1.0           // &lt;1 pulls ribbons toward their bone (axis or centre), &gt;1 lifts them off the skin
#define SR_WIDTH 0.150          // ribbon width
#define SR_ALPHA 0.75
#define SR_COLOR float3(0.86, 0.72, 0.48)
#define SR_UV_REPEAT 1.0        // texture repeats along a strip
#define SR_UV_SPEED 0.35        // texture scroll speed along strips (flowing sand)
#define SR_WOBBLE 0.03          // shimmer: radial wobble as a fraction of the ring radius
#define SR_WOBBLE_SPEED 2.0

emitter SR_root_0
{
	varying float3 p_base;
	varying float3 p_axis;
	varying number p_u;
	varying number p_time;
	SPAWN(number in_time = 0)
	{
		local number k = index();		// strip vertex index; 4 vertices, emitted once, in order
		p_base = ((k &lt; 2) ? ((k &lt; 1) ? float3(0.7446, -0.8007, 0.2919) : float3(0.4756, -1.1672, -0.5920)) : ((k &lt; 3) ? float3(0.0432, -1.4093, -1.4795) : float3(-0.6926, -1.2638, -2.1344)));
		p_axis = float3(-0.0124, -0.8064, -1.1721);	// the point SR_RADIUS pulls towards
		p_u = k / 3.0;
		p_time = in_time;
	}
	SIM
	{
		p_time = p_time + delta_time();
	}
	property geometry_type = string_aligned;
	property blend_type = alpha;
	property shadows = false;	// FireFX default is true: puffs/ribbons cast shadows
	property material_lighting = none;
	RENDER
	{
		local number wob = sin(p_time * SR_WOBBLE_SPEED + p_u * 13.0 + 1.800) * SR_WOBBLE;
		local float3 pos = p_axis + (p_base - p_axis) * (SR_RADIUS * (1 + wob));
		export("POSITION", pos * SR_SCALE);	// bone-local: rides the animation
		export("WIDTH", SR_WIDTH * SR_SCALE);
		export("BASECOLOR_UV_Y_RANGE", float2(0, 1));
		export("BASECOLOR_UV_X_VALUE", p_u * SR_UV_REPEAT - p_time * SR_UV_SPEED);
		export("COLOR", SR_COLOR * SR_ALPHA);	// premultiplied
		export("ALPHA", SR_ALPHA);
	}
}

emitter SR_root_1
{
	varying float3 p_base;
	varying float3 p_axis;
	varying number p_u;
	varying number p_time;
	SPAWN(number in_time = 0)
	{
		local number k = index();		// strip vertex index; 3 vertices, emitted once, in order
		p_base = ((k &lt; 1) ? float3(-0.1587, 1.5979, -1.2269) : ((k &lt; 2) ? float3(-0.2186, 1.0571, -1.8888) : float3(-0.4224, 0.3730, -2.3658)));
		p_axis = float3(-0.0124, -0.8064, -1.1721);	// the point SR_RADIUS pulls towards
		p_u = k / 2.0;
		p_time = in_time;
	}
	SIM
	{
		p_time = p_time + delta_time();
	}
	property geometry_type = string_aligned;
	property blend_type = alpha;
	property shadows = false;	// FireFX default is true: puffs/ribbons cast shadows
	property material_lighting = none;
	RENDER
	{
		local number wob = sin(p_time * SR_WOBBLE_SPEED + p_u * 13.0 + 0.500) * SR_WOBBLE;
		local float3 pos = p_axis + (p_base - p_axis) * (SR_RADIUS * (1 + wob));
		export("POSITION", pos * SR_SCALE);	// bone-local: rides the animation
		export("WIDTH", SR_WIDTH * SR_SCALE);
		export("BASECOLOR_UV_Y_RANGE", float2(0, 1));
		export("BASECOLOR_UV_X_VALUE", p_u * SR_UV_REPEAT - p_time * SR_UV_SPEED);
		export("COLOR", SR_COLOR * SR_ALPHA);	// premultiplied
		export("ALPHA", SR_ALPHA);
	}
}

group SLG_root
{
	SPAWN
	{
		emit_count("SR_root_0", 4) { export("in_time", 0); };
		emit_count("SR_root_1", 3) { export("in_time", 0); };
	}
}

