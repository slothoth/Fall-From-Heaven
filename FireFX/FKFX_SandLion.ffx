	varying float3 p_axis;
	varying number p_u;
	varying number p_time;
	SPAWN(number in_time = 0)
	{
		local number k = index();		// strip vertex index; 3 vertices, emitted once, in order
		p_base = ((k &lt; 1) ? float3(1.5189, 1.7951, 0.4920) : ((k &lt; 2) ? float3(1.5380, 1.4258, -0.2439) : float3(1.6067, 0.6081, -0.4473)));
		p_axis = float3(1.4817, 0.0352, 0.0151);	// the point SR_RADIUS pulls towards
		p_u = k / 2.0;
		p_time = in_time;
	}
	SIM
	{
		p_time = p_time + delta_time();
	}
	property geometry_type = string_aligned;
	property blend_type = alpha;
	property shadows = false;	// FireFX default is true: puffs/ribbons cast shadows
	property material_lighting = none;
	RENDER
	{
		local number wob = sin(p_time * SR_WOBBLE_SPEED + p_u * 13.0 + 3.100) * SR_WOBBLE;
		local float3 pos = p_axis + (p_base - p_axis) * (SR_RADIUS * (1 + wob));
		export("POSITION", pos * SR_SCALE);	// bone-local: rides the animation
		export("WIDTH", SR_WIDTH * SR_SCALE);
		export("BASECOLOR_UV_Y_RANGE", float2(0, 1));
		export("BASECOLOR_UV_X_VALUE", p_u * SR_UV_REPEAT - p_time * SR_UV_SPEED);
		export("COLOR", SR_COLOR * SR_ALPHA);	// premultiplied
		export("ALPHA", SR_ALPHA);
	}
}

