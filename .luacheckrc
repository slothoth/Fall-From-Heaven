-- 'include' loads sibling scripts; other files' globals leak in at runtime.
allow_defined = true

-- Keep the first pass focused on real defects, not style noise.
ignore = {
    "212",  -- unused argument (event handlers take fixed signatures)
    "213",  -- unused loop variable
    "542",  -- empty if branch
}

max_line_length = false
