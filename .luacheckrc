-- AUTO-GENERATED by civ6/lua_lint/gen_luacheckrc.py -- do not edit by hand.
-- Civ6 gameplay Lua runs as HavokScript (~Lua 5.1). This config teaches luacheck
-- the Civ6 API (318 globals from the LuaCATS defs) plus the mod's own
-- 164 cross-file globals, so `undefined global` flags real typos/wrong-context calls.

-- HavokScript extends Lua 5.1: table.count / table.fill are engine builtins (used
-- throughout the base game), and ExposedMembers is the cross-context bridge table.
-- Merged via "lua51+civ6" so std table functions (insert/remove/...) are preserved.
stds.civ6 = {
    read_globals = {
        table = { fields = { count = {}, fill = {} } },
    },
    globals = {
        ExposedMembers = { read_only = false, other_fields = true },
    },
}

std = "lua51+civ6"

