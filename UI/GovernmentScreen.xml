<?xml version="1.0" encoding="utf-8"?>
<Context xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="..\..\..\..\..\CivTech\Libs\ForgeUI\ForgeUI_Assets\Controls.xsd">

    <Container ID="Vignette" Style="FullScreenVignetteConsumer" />

    <!-- Contained modal: fixed size, centered on screen, so the ModalScreenWide gold frame
         wraps the content instead of running off the edges of a full-width screen. -->
	<Container ID="MainContainer" Anchor="C,C" Size="parent,768">
        <Image ConsumeMouse="1" Anchor="L,B" Size="parent,parent" Texture="Wood_Pattern" StretchMode="Tile"/>
		<Grid ConsumeMouse="1" Size="Parent-368,Parent-40" Offset="368, 40" Texture="Wood_CarvedBorder" SliceCorner="240,240" SliceSize="20,20" SliceTextureSize="497,500"/>

                <!-- Far-left: Governments list + Confirm button. A child of MainContainer so the government column is fixed
                     and doesnt scroll sideways with the policy columns. Its width must stay
                     in sync with GOV_COLUMN_W in Lua and with the Grid backing offset above. -->
                <Container ID="GovernmentColumn" Anchor="L,T" Offset="0,0" Size="368,parent">
                    <Image ID="GovParchment" Anchor="L,T" Offset="0,0" Size="parent,parent" Texture="Parchment_Pattern" StretchMode="Tile"/>

                    <Grid ID="OptionsPanel" ConsumeAllMouse="1" Anchor="C,T" Offset="0,94" Size="210,64"
                          Texture="Controls_OptionPanel" SliceCorner="3,3" SliceSize="10,52" SliceTextureSize="16,64">
                        <Image Anchor="C,T" Offset="0,-30" Size="240,59" Texture="Controls_HeaderBanner">
                            <Label Anchor="C,T" Offset="0,8" Style="FontFlair16" Color0="38,39,32,255"
                                   String="LOC_TREE_OPTIONS" SmallCaps="20" SmallCapsType="EveryWord"/>
                        </Image>
                        <GridButton ID="ToggleFlavoredNamesButton" Anchor="C,T" Offset="0,0" Size="194,26" TextOffset="32,6" Style="TreeOptionText">
                            <GridData Texture="Controls_CheckButton2" StateOffsetIncrement="0,26" SliceCorner="30,14" SliceSize="1,1" SliceTextureSize="41,26"/>
                        </GridButton>
                        <GridButton ID="ToggleUnlockBadgesButton" Anchor="C,T" Offset="0,22" Size="194,26" TextOffset="32,6" Style="TreeOptionText">
                            <GridData Texture="Controls_CheckButton2" StateOffsetIncrement="0,26" SliceCorner="30,14" SliceSize="1,1" SliceTextureSize="41,26"/>
                        </GridButton>
                    </Grid>

                    <!-- Bottom-anchored (C,B) so the list grows up off the Confirm button and
                         leaves the top of the column free for options. the height is fitted to the list content in
                         RealizeGovernmentsList, capped at GOV_LIST_MAX_H. -->
                    <Grid ID="GovernmentSlot" Anchor="C,B" Offset="0,49" Size="210,parent-104">
                        <ScrollPanel ID="GovernmentListScroller" Anchor="C,T" Offset="0,0" Size="parent,parent" Vertical="1"
                                     AutoScrollBar="1" FullClip="1">
                            <Stack ID="GovernmentListStack" Offset="4,4" StackGrowth="Down" StackPadding="0,2"/>
                            <ScrollBar Anchor="R,T" AnchorSide="I,I" Offset="-16,0" Style="ScrollVerticalBar"
                                       Size="8,parent-10"/>
                        </ScrollPanel>
                    </Grid>
                    <GridButton ID="ConfirmPolicies" Anchor="C,B" Offset="4,0" Size="200,41" Style="ButtonConfirm"
                                DisabledCallbacks="1"/>
                </Container>

                <!-- Offset/Size are recomputed in Lua, these are just  static fallback
                     (FitModalWidth for X, ApplyUniformColumnHeights for the vertical framing) -->
                <ScrollPanel ID="ColumnsScroller" Anchor="L,T" Offset="368,40" Size="parent-368,parent-40"
                             Horizontal="1" AutoScrollBar="1" FullClip="1">
                <!-- One column per policy category (title / policy listbox / description card),
                     all built at runtime by BuildCategoryColumns. -->
                <Stack ID="MainColumns" Anchor="L,T" Offset="0,0" StackGrowth="Right" StackPadding="10,0"/>
                    <ScrollBar Style="ScrollHorizontalBar" Anchor="C,B" AnchorSide="I,I" Offset="0,0" Size="parent-20,8"/>
                </ScrollPanel>

                <!-- Modal: gold ScreenFrame + title bar + close (X) button + yields bar.
                     Sized to the modal (parent,parent) so the gold frame wraps the content. -->
                <Container Style="ModalScreenWide" Size="parent,parent"/>

	</Container>

    <!-- ==================================================================	-->
    <!--	Instances                                                       -->
    <!-- ==================================================================	-->

    <!-- One policy category column: decorative slot frame (title + policy listbox +
         selector pointer) above a description card. Built once per policy slot type by
         BuildCategoryColumns(); the per-category title/policy-texture are applied in Lua. -->
    <Instance Name="PolicyCategoryColumn">
        <Container ID="Root" Size="208,584">
            <Image ID="Slot" Anchor="C,T" Offset="0,40" Texture="Governments_CardSlot_Vertical.dds">
                <Label ID="Title" Anchor="C,T" Offset="0,24" Style="PolicyRowHeader"/>
    <!--        <Image ID="Watermark" Anchor="C,T" Offset="0,250" Size="parent-25,parent-275" Texture="Governments_WatermarkMilitary" StretchMode="Fill" Color="GovWaterMark"/> -->
                <ScrollPanel ID="ListScroller" Anchor="C,T" Offset="-3,54" Size="parent-16,parent-76" Vertical="1"
                             AutoScrollBar="1" FullClip="1">
                    <Stack ID="PolicyStack" Offset="4,0" StackGrowth="Down" StackPadding="0,2"/>
                    <ScrollBar Anchor="R,T" AnchorSide="I,I" Offset="28,0" Style="ScrollVerticalBar" Size="8,parent-10"/>
                </ScrollPanel>
                <Image ID="Pointer" Anchor="C,T" Offset="0,401" Size="parent-20,31" Texture="Governments_PolicyCategorySelector" StretchMode="Fill" Rotate="90"/>
            </Image>
            <Image ID="DescCard" Anchor="C,T" Offset="0,489" Texture="Governments_Backing_Card.dds">
                <Label ID="DescTitle" Anchor="C,T" Offset="0,18" Style="FontFlair20" FontSize="14" SmallCaps="18" FontStyle="glow" Color0="9,46,75,255" Color1="16,43,67,100" TruncateWidth="200" TruncatedTooltip="1"/>
                <Container Size="206,93" Anchor="C,T" Offset="0,40">
                    <Image ID="DescImage" Anchor="C,C" Size="174,78" Texture="GOVERNMENT_AUTOCRACY" TextureOffset="0,0"/>
                    <Image ID="ImageFrame" Anchor="C,C" Offset="0,0" Texture="Governments_ImageFrame_Small.dds"/>
                </Container>
				<Grid ID="DescBonusBacking" Anchor="C,T" Offset="0,138" Size="166,100" Texture="Controls_SubContainer2" SliceCorner="17,17" SliceSize="1,1" SliceTextureSize="36,35" Color="GovBonusDark" MinSize="36,35" AutoSizePadding="0,3">
					 <Label ID="Desc" Anchor="C,C" Offset="0,0" WrapWidth="156" Style="FontNormal12"/>
				</Grid>

            </Image>
        </Container>
    </Instance>

    <!-- A selectable policy name row inside a category listbox.

         Root is a fixed-size cell matching the card's resting size, so the stack spacing never
         changes and a hovered card pops out over its neighbours instead of reflowing the list.

         The Button itself doesnt resize. TThe grown card is therefore drawn by the CardArt Image, which does
         scale. See SetPolicyCardSize in Lua. -->
    <Instance Name="PolicyNameItem">
        <Container ID="Root" Size="192,39">
            <!-- DisabledCallbacks: locked policies are SetDisabled(true) so they render greyed and
                 are not selectable, but they must still fire mouse-enter/exit so hovering one
                 previews its description.  -->
            <GridButton ID="Button" Anchor="L,C" Size="140,39" Offset="26,3" Texture="Governments_EconomicCard_Compact.dds" DisabledCallbacks="1"
                        SliceCorner="0,0" SliceSize="0,0" SliceTextureSize="140,39" StateOffsetIncrement="0,0">
                <!-- The enlarged card art, shown only while hovered. Carries the same texture as
                     the Button and is bigger than it, so it completely covers the un-scaled
                     button art. Declared first so the Active/Highlight frames and the label still
                     draw on top of it. -->
                <Image ID="CardArt" Anchor="C,C" Size="152,43" StretchMode="Fill" Hidden="1"/>
                <Image ID="Active" Anchor="C,C" Size="148,44" Offset="0,0" Texture="Governments_ActiveCard_Small.dds" Hidden="1"/>
                <Image ID="Highlight" Anchor="C,C" Size="148,44" Offset="2,0" Texture="Governments_SelectedCard_Small.dds" Hidden="1"/>
                <Label ID="Name" Anchor="C,C" Offset="1,-1" WrapWidth="176" Style="FontNormal12"/>
            </GridButton>
            <Stack ID="BadgeStackLeft"  Anchor="L,C" Offset="-8,3"   StackGrowth="Down" StackPadding="0,2" Hidden="1"/>
            <Stack ID="BadgeStackRight" Anchor="L,C" Offset="170,3" StackGrowth="Down" StackPadding="0,2" Hidden="1"/>
        </Container>
    </Instance>

    <!-- One unlock-requirement icon inside a PolicyNameItem badge stack. -->
    <Instance Name="PolicyUnlockBadge">
        <Image ID="Icon" Anchor="L,T" Size="38,38"/>
    </Instance>

    <Instance Name="GovernmentTierDivider">
        <Container ID="Root" Size="208,22">
            <Label ID="TierLabel" Anchor="C,B" Offset="0,0" Style="TreeEraBigText"/>
        </Container>
    </Instance>

    <Instance Name="GovernmentNameItem">
        <Container ID="Root" Size="208,74">
            <!-- Selection is shown by swapping the button texture (Backing -> BackingSelected) -->
            <GridButton ID="Button" Anchor="C,T" Size="208,56" Texture="Governments_Backing_Card.dds" DisabledCallbacks="1"
                SliceCorner="27,27" SliceSize="154,208" SliceTextureSize="208,262">
                <Label ID="Name" Anchor="C,C" WrapWidth="176"  Style="FontFlair20" FontSize="14" SmallCaps="18" FontStyle="glow" Color0="9,46,75,255" Color1="16,43,67,100" TruncateWidth="200" TruncatedTooltip="1"/>
                <Container Anchor="L,B" Size="parent,37" Offset="0,5">
                    <Image ID="ArtLeft" Anchor="L,T" Offset="4,0" Size="31,37" Texture="Governments_Leaf"/>
                    <Image ID="ArtRight" Anchor="R,T" Offset="4,0" Size="31,37" Texture="Governments_Leaf" FlipX="1"/>
                </Container>
            </GridButton>
        </Container>
    </Instance>


</Context>
