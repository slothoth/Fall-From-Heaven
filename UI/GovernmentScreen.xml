<?xml version="1.0" encoding="utf-8"?>
<Context xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="..\..\..\..\..\CivTech\Libs\ForgeUI\ForgeUI_Assets\Controls.xsd">

    <Container ID="Vignette" Style="FullScreenVignetteConsumer" />

    <!-- Contained modal: fixed size, centered on screen, so the ModalScreenWide gold frame
         wraps the content instead of running off the edges of a full-width screen. -->
    <Container ID="MainContainer" Anchor="C,C" Size="1360,720">
        <Image ConsumeMouse="1" Anchor="C,C" Size="parent,parent" Texture="Wood_Pattern" StretchMode="Tile"/>

                <!-- FFH single-policy-per-category picker: far-left governments column + confirm,
                     then one column per policy category (title / policy listbox / description). -->
                <Stack ID="MainColumns" Anchor="C,T" Offset="0,0" StackGrowth="Right" StackPadding="10,0">

                    <!-- Far-left: Governments list + Confirm button -->
                    <Container ID="GovernmentColumn" Size="210,648">
                        <Image ID="GovParchment" Offset="-25, 0" Size="240,parent+72" Texture="Parchment_Pattern" StretchMode="Tile"/>

                        <Grid ID="GovernmentSlot" Anchor="C,T" Offset="-20,44" Size="210,parent-68" >
                            <ScrollPanel ID="GovernmentListScroller" Anchor="C,T" Offset="0,0" Size="parent,parent-58" Vertical="1"
                                         AutoScrollBar="1" FullClip="1">
                                <Stack ID="GovernmentListStack" Offset="4,0" StackGrowth="Down" StackPadding="0,2"/>
                                <ScrollBar Anchor="R,T" AnchorSide="I,I" Offset="-16,0" Style="ScrollVerticalBar"
                                           Size="8,parent-10"/>
                            </ScrollPanel>
                        </Grid>
                        <GridButton ID="ConfirmPolicies" Anchor="C,B" Offset="0,0" Size="200,41" Style="ButtonConfirm"
                                    DisabledCallbacks="1"/>
                    </Container>

                    <!-- The five policy-category columns (Military/Economic/Diplomatic/Culture/
                         Religion) are identical in structure, so they are built at runtime from
                         the PolicyCategoryColumn instance below; see BuildCategoryColumns(). -->

                </Stack>

                <!-- Modal chrome: gold ScreenFrame + title bar + close (X) button + yields bar.
                     Sized to the modal (parent,parent) so the gold frame wraps the content. -->
                <Container Style="ModalScreenWide" Size="parent,parent"/>

            </Container>

    <!-- ==================================================================	-->
    <!--	Instances                                                       -->
    <!-- ==================================================================	-->

    <!-- One policy category column: decorative slot frame (title + policy listbox +
         selector pointer) above a description card. Built five times by BuildCategoryColumns();
         the per-category watermark/title/policy-texture are applied in Lua. Single root. -->
    <Instance Name="PolicyCategoryColumn">
        <Container ID="Root" Size="210,584">
            <Grid ID="Slot" Anchor="C,T" Offset="0,0" Size="210,356" Texture="Governments_CardSlot" SliceCorner="30,50" SliceSize="615,89" SliceTextureSize="675,189">
                <Label ID="Title" Anchor="C,T" Offset="0,24" Style="PolicyRowHeader"/>
                <Image ID="Watermark" Anchor="C,T" Offset="0,250" Size="185,81" Texture="Governments_WatermarkMilitary" StretchMode="Fill" Color="GovWaterMark"/>
                <ScrollPanel ID="ListScroller" Anchor="C,T" Offset="20,54" Size="parent-16,280" Vertical="1"
                             AutoScrollBar="1" FullClip="1">
                    <Stack ID="PolicyStack" Offset="4,0" StackGrowth="Down" StackPadding="0,2"/>
                    <ScrollBar Anchor="R,T" AnchorSide="I,I" Offset="0,0" Style="ScrollVerticalBar" Size="8,parent-10"/>
                </ScrollPanel>
                <Image ID="Pointer" Anchor="C,T" Offset="0,328" Size="173,31" Texture="Governments_PolicyCategorySelector" StretchMode="Fill" Rotate="90"/>
            </Grid>
            <Grid ID="DescCard" Anchor="C,T" Offset="0,364" Size="210,300" Texture="Governments_Backing" SliceCorner="15,20"
                  SliceSize="322,105" SliceTextureSize="352,145">
                <Label ID="DescTitle" Anchor="C,T" Offset="0,16" Style="FontFlair20" FontSize="14" SmallCaps="18" FontStyle="glow" Color0="9,46,75,255" Color1="16,43,67,100" TruncateWidth="200" TruncatedTooltip="1"/>
                <Container Size="206,93" Anchor="C,T" Offset="0,40">
                    <Image ID="DescImage" Anchor="C,C" Size="194,83" Texture="GOVERNMENT_AUTOCRACY" TextureOffset="0,80"/>
                    <Grid ID="ImageFrame" Anchor="C,C" Offset="0,0" Size="196,93" Texture="Governments_ImageFrame" SliceCorner="20,20" SliceSize="296,51" SliceTextureSize="336,91"/>
                </Container>
                <Label ID="Desc" Anchor="C,T" Offset="0,150" WrapWidth="184" Style="FontNormal12"/>
            </Grid>
        </Container>
    </Instance>

    <!-- A selectable policy name row inside a category listbox -->
    <Instance Name="PolicyNameItem">
        <!-- DisabledCallbacks: locked policies are SetDisabled(true) so they render greyed and
             are not selectable, but they must still fire mouse-enter/exit so hovering one
             previews its description. Without this a disabled button swallows all input. -->
        <!-- StateOffsetIncrement MUST be 0,0: the texture is a flat card, not a vertical
             state atlas. A non-zero offset makes the disabled state (locked policies,
             SetDisabled(true)) sample off the texture and render blank. -->
        <GridButton ID="Button" Anchor="C,C" Size="140,39" Texture="Governments_EconomicCard_Compact.dds" DisabledCallbacks="1"
                    SliceCorner="0,0" SliceSize="0,0" SliceTextureSize="140,39" StateOffsetIncrement="0,0">
            <!-- "Active" = the policy actually slotted in-game right now. Drawn under the
                 others; only shown while it is NOT also the staged selection, so the player
                 can see what is still in effect after picking something new. -->
            <Image ID="Active" Anchor="C,C" Size="148,44" Texture="Governments_ActiveCard_Small.dds" Hidden="1"/>
            <Image ID="Highlight" Anchor="C,C" Size="148,44" Texture="Governments_ActiveCard_Small.dds" Hidden="1"/>
            <Box ID="Hover" Size="parent,parent" Color="78,119,151,90" Hidden="1"/>
            <Label ID="Name" Anchor="C,C" Offset="0,0" WrapWidth="176" Style="FontNormal14"/>
        </GridButton>
    </Instance>

    <Instance Name="GovernmentTierDivider">
        <Container ID="Root" Size="208,22">
            <Label ID="TierLabel" Anchor="C,B" Offset="0,0" Style="TreeEraBigText"/>
        </Container>
    </Instance>

    <Instance Name="GovernmentNameItem">
        <Container ID="Root" Size="208,74">
            <!-- Selection is shown by swapping the button texture (Backing -> BackingSelected) -->
            <GridButton ID="Button" Anchor="C,T" Size="208,56" Texture="Governments_Backing_Card.dds" DisabledCallbacks="1"
                SliceCorner="27,27" SliceSize="154,208" SliceTextureSize="208,262">
                <Label ID="Name" Anchor="C,C" WrapWidth="176"  Style="FontFlair20" FontSize="14" SmallCaps="18" FontStyle="glow" Color0="9,46,75,255" Color1="16,43,67,100" TruncateWidth="200" TruncatedTooltip="1"/>
                <Container Anchor="L,B" Size="parent,37" Offset="0,5">
                    <Image ID="ArtLeft" Anchor="L,T" Offset="4,0" Size="31,37" Texture="Governments_Leaf"/>
                    <Image ID="ArtRight" Anchor="R,T" Offset="4,0" Size="31,37" Texture="Governments_Leaf" FlipX="1"/>
                </Container>
            </GridButton>
        </Container>
    </Instance>


</Context>
