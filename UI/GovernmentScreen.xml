    <!-- ==================================================================	-->
    <!--	Instances                                                       -->
    <!-- ==================================================================	-->

    <!-- A selectable policy name row inside a category listbox -->
    <Instance Name="PolicyNameItem">
        <!-- DisabledCallbacks: locked policies are SetDisabled(true) so they render greyed and
             are not selectable, but they must still fire mouse-enter/exit so hovering one
             previews its description. Without this a disabled button swallows all input. -->
        <!-- StateOffsetIncrement MUST be 0,0: the texture is a flat card, not a vertical
             state atlas. A non-zero offset makes the disabled state (locked policies,
             SetDisabled(true)) sample off the texture and render blank. -->
        <GridButton ID="Button" Anchor="C,C" Size="140,39" Texture="Governments_EconomicCard_Compact.dds" DisabledCallbacks="1"
                    SliceCorner="0,0" SliceSize="0,0" SliceTextureSize="140,39" StateOffsetIncrement="0,0">
            <!-- "Active" = the policy actually slotted in-game right now. Drawn under the
                 others; only shown while it is NOT also the staged selection, so the player
                 can see what is still in effect after picking something new. -->
            <Image ID="Active" Anchor="C,C" Size="148,44" Texture="Governments_ActiveCard_Small.dds" Hidden="1"/>
            <Image ID="Highlight" Anchor="C,C" Size="148,44" Texture="Governments_ActiveCard_Small.dds" Hidden="1"/>
            <Box ID="Hover" Size="parent,parent" Color="78,119,151,90" Hidden="1"/>
            <Label ID="Name" Anchor="C,C" Offset="0,0" WrapWidth="176" Style="FontNormal14"/>
        </GridButton>
    </Instance>

